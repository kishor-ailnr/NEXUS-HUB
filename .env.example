# ==========================================
# NEXUS WAYS - Unified Environment Configuration
# ==========================================

# ------------------------------------------
# Backend API Variables (apps/api)
# ------------------------------------------
PORT=3000
NODE_ENV=production
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>
FRONTEND_ORIGIN=https://smart-supply-chain-v3.web.app,http://localhost:5173,http://localhost:3000
COOKIE_DOMAIN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=

# ------------------------------------------
# Frontend Web Variables (apps/web - baked in at build time)
# ------------------------------------------
# Set these as build args / environment variables in Render
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Optional: When running frontend from same Render service, leave empty for relative paths (/api)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_SENTRY_DSN=
